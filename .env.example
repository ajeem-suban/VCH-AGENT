# Local SQLite database. This file is safe to copy to .env and customize.
VCH_DATABASE_PATH=data/vch.sqlite3

# Required only when using the local GGUF semantic-feature extractor.
VCH_LLM_MODEL_PATH=models/Phi-3.5-mini-instruct.gguf
VCH_LLM_MODEL_VERSION=phi-3.5-mini-instruct

# Starting values for an RTX 3050 6GB. Benchmark and adjust before production use.
VCH_LLM_GPU_LAYERS=20
VCH_LLM_CONTEXT_SIZE=2048
VCH_LLM_MAX_TOKENS=128
VCH_LLM_MAX_INPUT_CHARACTERS=8000

# Required only when using Reddit harvesting. Do not commit real values.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=VCH-Agent/0.1 by u/your_reddit_username
VCH_REDDIT_SUBREDDITS=python,MachineLearning
VCH_REDDIT_CANDIDATE_LIMIT=100
VCH_REDDIT_MAX_AGE_HOURS=24

# Public YouTube RSS feeds. Use channel IDs (usually beginning with UC), not handles.
VCH_YOUTUBE_CHANNEL_IDS=
VCH_YOUTUBE_CANDIDATE_LIMIT=100
VCH_YOUTUBE_MAX_AGE_HOURS=24
VCH_YOUTUBE_REQUEST_TIMEOUT_SECONDS=10
VCH_YOUTUBE_TRANSCRIPT_LANGUAGES=en
VCH_YOUTUBE_TRANSCRIPT_MAX_CHARACTERS=30000
